    "check": "npm run build && node tools/check-readable-bundles.mjs"
  },
  "devDependencies": {
    "@babel/generator": "7.27.0",
    "@babel/parser": "7.27.0",
    "@babel/traverse": "7.27.0",
    "@babel/types": "7.27.0",
    "playwright-core": "1.52.0",
    "prettier": "3.5.3"
  }
}
