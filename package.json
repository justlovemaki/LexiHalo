  "type": "module",
  "scripts": {
    "recover": "node tools/recover-webpack.cjs && node tools/recover-semantics.cjs && prettier --write \"recovered/**/*.{js,json,md}\" \"src-recovered/**/*.{js,css,json,md}\"",
    "build": "node tools/build-readable-bundles.mjs",
    "test:browser": "node tools/test-readable-bundles.mjs",
